{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unicomp-gemini-proxy",
  "main": "worker/gemini-proxy.js",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173,http://127.0.0.1:5173,https://zaa18.github.io"
  },
  "secrets": {
    "required": ["GEMINI_API_KEY"]
  }
}
